<script>
const slides = document.querySelectorAll('.slide');
let currentSlide = 0;
const totalSlides = slides.length;

function showSlide(index) {
  if (index < 0) index = 0;
  if (index >= totalSlides) index = totalSlides - 1;
  slides.forEach((slide, i) => {
    slide.classList.remove('active', 'visible');
    if (i === index) slide.classList.add('active', 'visible');
  });
  currentSlide = index;
  document.getElementById('pageDisplay').textContent = `${index + 1} / 25`;
}

function goToSlide(index) {
  showSlide(index);
  // Sync dropdown with current page
  const dropdown = document.getElementById('pageJump');
  if (dropdown) dropdown.value = index + 1;
}

function nextSlide() { showSlide(currentSlide + 1); }
function prevSlide() { showSlide(currentSlide - 1); }

document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextSlide(); }
  if (e.key === 'ArrowLeft') { e.preventDefault(); prevSlide(); }
});

// Add click handlers to all clickable cards
document.querySelectorAll('.info-card.clickable').forEach(card => {
  card.addEventListener('click', () => {
    const target = card.getAttribute('data-goto');
    if (target) goToSlide(parseInt(target));
  });
});
</script>
